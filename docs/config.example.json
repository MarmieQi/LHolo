{
    "version": 13,
    "interface": {
        "language": "zh_CN"
    },
    "rendering": {
        "structureBounds": true,
        "correction": {
            "fillOpacityPercent": 15,
            "outlineOpacityPercent": 100,
            "seeThrough": false
        },
        "missingSeeThrough": false
    },
    "hud": {
        "projection": {
            "enabled": true,
            "show": {
                "fileName": true,
                "layer": true,
                "overallProgress": false,
                "progress": true,
                "wrongState": true,
                "wrongType": true,
                "extraBlocks": true,
                "projectedBlockName": true
            },
            "position": {
                "anchor": "bottomLeft"
            },
            "scalePercent": 100,
            "backgroundOpacityPercent": 60
        },
        "materials": {
            "enabled": false,
            "convertToStacks": false,
            "itemsPerPage": 5,
            "position": {
                "anchor": "bottomRight"
            },
            "scalePercent": 100,
            "backgroundOpacityPercent": 60
        },
        "write": {
            "enabled": true,
            "position": {
                "anchor": "topCenter"
            },
            "scalePercent": 100,
            "backgroundOpacityPercent": 60
        }
    },
    "input": {
        "altWheelOffset": true,
        "hotkeys": {
            "openMenu": "Alt+M",
            "moveLeft": "Ctrl+Left",
            "moveRight": "Ctrl+Right",
            "moveForward": "Ctrl+Up",
            "moveBackward": "Ctrl+Down",
            "moveUp": "Shift+Up",
            "moveDown": "Shift+Down",
            "layerIncrease": "Alt+Up",
            "layerDecrease": "Alt+Down",
            "materialHudPreviousPage": null,
            "materialHudNextPage": null
        }
    },
    "placement": {
        "consentGiven": false,
        "radius": 4,
        "breakCooldownSeconds": 10
    }
}
